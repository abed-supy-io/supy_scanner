# Copy to .env and fill in. NEVER commit the real .env.
# --------------------------------------------------------------------------

# HTTP server
PORT=8080
# Public base URL of this service (used for Stripe redirect URLs).
PUBLIC_URL=http://localhost:8080

# --- License signing (REQUIRED) -------------------------------------------
# Ed25519 PRIVATE signing key as base64-encoded PKCS8 PEM.
# Generate with:  npm run keygen
# The keygen prints the matching PUBLIC key to paste into the Flutter library
# (kSupyLicensePublicKeyBase64) and writes this private value for you.
# This is the ONE secret that must never leak — it can mint valid licenses.
SUPY_LICENSE_PRIVATE_KEY_B64=

# License id prefix + default validity window (days) for issued licenses.
LICENSE_ID_PREFIX=lic
LICENSE_TERM_DAYS=365

# --- Stripe (optional in dev) ---------------------------------------------
# If unset, /checkout returns 501 and you can still exercise issuance by
# POSTing a fake event body to /webhook in test mode (see README).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Map Stripe Price IDs -> license tier. Fill with your real price ids.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=

# Seats granted per tier (0 = unmetered).
SEATS_STARTER=1
SEATS_GROWTH=5
SEATS_ENTERPRISE=0
