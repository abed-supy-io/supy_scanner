# Dart / Flutter
.dart_tool/
.packages
.pub-cache/
.pub/
build/
**/build/
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock
.fvm/

# IDE
.idea/
.vscode/
*.iml
*.iws
*.ipr

# macOS
.DS_Store

# Android
# Glob-anchored so they match the plugin's android/ wherever it lives
# (e.g. flutter/supy_scanner/android/) after the monorepo restructure.
**/android/.gradle/
**/android/local.properties
**/android/captures/
**/android/.cxx/

# iOS / Xcode
# V1-S2-02: zxing-cpp xcframework + build tree are generated by
# tools/build_zxing_xcframework.sh and must never be committed.
**/ios/Vendor/ZXing.xcframework/
build/ios-zxing/
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/Generated.xcconfig
**/Pods/
**/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/

# Example app build artifacts
**/example/.flutter-plugins
**/example/.flutter-plugins-dependencies
**/example/ios/Flutter/Generated.xcconfig
**/example/ios/Flutter/flutter_export_environment.sh
**/example/android/local.properties

# Coverage
coverage/
*.lcov

# Logs
*.log

# Native (CMake) build trees
# The shared core moved native/ -> core/; match build trees wherever they land.
**/build-test/
**/build*/

# SwiftPM
.build/

# DSQ bench outputs (regenerated by tools/bench/run_bench.dart)
tools/bench/report/
build/dsq-bench/
